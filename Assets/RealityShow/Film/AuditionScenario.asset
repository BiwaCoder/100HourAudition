    speaker: "\u6C99\u7E54 / \u304A\u52A9\u3051AI"
    text: "\u3072\u307E\u308A\u3055\u3093\u3001\u307E\u305A\u306F\u304A\u540D\u524D\u3068\u3001\u3054\u6328\u62F6\u304B\u3089\u3044\u304B\u304C\u3067\u3057\u3087\u3046\u3002\u8AAD\u66F8\u3084\u5C0F\u3055\u306A\u55AB\u8336\u5E97\u306E\u304A\u8A71\u3082\u3001\u8DDD\u96E2\u3092\u7E2E\u3081\u308B\u304D\u3063\u304B\u3051\u306B\u306A\u308A\u307E\u3059\u3002\n\u96C6\u4E2D\u529B\u306F\u4F1A\u8A71\u3054\u3068\u306B3\u30014\u56DE\u306E\u4F1A\u8A71\u3067\u9078\u8003\u3067\u3059\u3002\u53F0\u672C\u306F\u7528\u610F\u3057\u307E\u3059\u304C\u3001\u4E38\u8AAD\u307F\u3059\u308B\u3068\u79C1\u307E\u3067\u7DCA\u5F35\u3057\u307E\u3059\u306E\u3067\u2026\u2026\u3054\u81EA\u5206\u306E\u8A00\u8449\u3067\u3069\u3046\u305E\u3002"
