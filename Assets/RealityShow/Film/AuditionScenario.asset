  beats:
  - id: opening0
    speaker: 100 Hour Audition Battle
    text: "\u6D77\u3068\u68EE\u306B\u56F2\u307E\u308C\u305F\u5CF6\u306E\u821E\u53F0\u3002\u56DB\u4EBA\u306E\u53C2\u52A0\u8005\u304C\u767E\u6642\u9593\u3092\u5171\u306B\u904E\u3054\u3057\u3001\u305F\u3063\u305F\u4E00\u4EBA\u306E\u5FC3\u3092\u5C04\u6B62\u3081\u308B\u6226\u3044\u304C\u4ECA\u59CB\u307E\u308B\u3002"
