    text: "\u30BF\u30A4\u30E0\u30EA\u30FC\u30D7\u3067\u3001\u3053\u306E\u7AE0\u306E\u5165\u53E3\u3078\u304A\u623B\u3057\u3057\u307E\u3057\u305F\u3002\u8A00\u3044\u305D\u3073\u308C\u305F\u8A00\u8449\u306B\u3001\u3082\u3046\u4E00\u5EA6\u681E\u3092\u631F\u307F\u307E\u3057\u3087\u3046\u3002\n\u8A18\u61B6\u3068\u53D6\u5F97\u30AB\u30FC\u30C9\u306F\u6B8B\u308A\u3001AGI\u306F3\u6D88\u8CBB\u3057\u307E\u3059\u3002\u4FE1\u983C\u30FB\u30B9\u30BF\u30FC\u30FB\u7DCA\u5F35\u30FB\u6642\u9593\u306F\u7AE0\u306E\u958B\u59CB\u6642\u70B9\u306B\u623B\u308A\u307E\u3059\u3002\u2026\u2026\u79C1\u306E\u7167\u308C\u305F\u8A18\u9332\u3082\u6B8B\u3063\u3066\u3044\u307E\u3059\u304C\u3001\u305D\u3061\u3089\u306F\u5185\u7DD2\u3067\u304A\u9858\u3044\u3057\u307E\u3059\u3002"
