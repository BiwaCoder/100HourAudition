    - himari
    - konoa
    - hikari
    - shiori
    - yuto
    camera: {fileID: 11400000, guid: 42d1bd45013cb4d1e8df7289bf6afb13, type: 2}
  - id: opening1
    speaker: "\u3072\u307E\u308A / YOU"
    text: "\u308F\u305F\u3057\u306F\u3072\u307E\u308A\u3002\u7AE5\u8A71\u3068\u5C0F\u3055\u306A\u751F\u304D\u7269\u304C\u597D\u304D\u306A\u4E8C\u5341\u4E8C\u6B73\u3002\u899A\u609F\u3068\u671F\u5F85\u3092\u80F8\u306B\u81EA\u5206\u306E\u8A00\u8449\u3067\u8AB0\u304B\u3068\u3064\u306A\u304C\u308A\u305F\u3044\u3002"
    actors:
    - himari
    camera: {fileID: 11400000, guid: 14a8d9a9cf9aa42e8a29669779d8b4b0, type: 2}
  - id: opening2
    speaker: "\u677E\u6751\u60A0\u6597 / THE ONE"
    text: "\u76F8\u624B\u306F\u677E\u6751\u60A0\u6597\u3002\u4E8C\u5341\u516B\u6B73\u306E\u30B2\u30FC\u30E0\u30AF\u30EA\u30A8\u30A4\u30BF\u30FC\u3002\u7A4F\u3084\u304B\u306A\u7B11\u9854\u306E\u5965\u3067\u3001\u5171\u306B\u7269\u8A9E\u3092\u7D21\u3052\u308B\u4E00\u4EBA\u3092\u63A2\u3057\u3066\u3044\u308B\u3002"
    actors:
    - yuto
    camera: {fileID: 11400000, guid: 2935891b2bb754749894b26bf446cbac, type: 2}
  - id: firstchoice
    speaker: "\u3072\u307E\u308A"
    text: "\u6700\u521D\u306E\u30E9\u30A4\u30C8\u304C\u70B9\u304F\u3002\u899A\u609F\u3068\u671F\u5F85\u306F\u3001\u307E\u3060\u58F0\u306B\u306A\u3089\u306A\u3044\u3002\n\u60A0\u6597\u306B\u3001\u3069\u3093\u306A\u81EA\u5206\u3092\u898B\u305B\u3088\u3046\uFF1F"
    actors:
    - himari
    - yuto
    camera: {fileID: 11400000, guid: b2ed6ac282f924091aa94e025da89745, type: 2}
  - id: review0
    speaker: "\u5B9F\u6CC1 \u30EC\u30F3"
    text: "\u3055\u3042\u3001100 Hour Audition Battle\u3001\u958B\u5E55\u3067\u3059\uFF01\n\u56DB\u4EBA\u304C\u4E00\u4EBA\u306E\u5FC3\u3092\u5C04\u6B62\u3081\u308B\u767E\u6642\u9593\u3002\u3057\u304B\u3057\u6700\u521D\u306E\u95A2\u9580\u306F\u3001\u7B2C\u4E00\u5370\u8C61\u3002\u4ECA\u3053\u3053\u3067\u4E00\u4EBA\u304C\u8131\u843D\u3057\u307E\u3059\u3002"
    actors:
    - ren
    - misa
    camera: {fileID: 11400000, guid: fc4ca17f88dd146c3a92a20e6aef4db4, type: 2}
  - id: review1
    speaker: "\u89E3\u8AAC \u30DF\u30B5"
    text: "\u60A0\u6597\u3055\u3093\u306B\u5C4A\u3044\u305F\u5370\u8C61\u3068\u3001\u8996\u8074\u8005\u306E\u671F\u5F85\u3002\u305D\u306E\u4E21\u65B9\u304C\u8A66\u3055\u308C\u307E\u3059\u3002\n\u305F\u3060\u3001\u6700\u521D\u306E\u4E00\u77AC\u3060\u3051\u3067\u306F\u898B\u3048\u306A\u3044\u601D\u3044\u3082\u3042\u308B\u3002\u821E\u53F0\u306E\u3072\u307E\u308A\u3055\u3093\u3092\u898B\u3066\u307F\u307E\u3057\u3087\u3046\u3002"
    actors:
    - misa
    - ren
    camera: {fileID: 11400000, guid: abcf6437b582f4f9081a93943c568409, type: 2}
  - id: firstloss
    speaker: "\u5B9F\u6CC1 \u30EC\u30F3 \u2192 \u3072\u307E\u308A"
    text: "\u300C\u6700\u521D\u306E\u8131\u843D\u8005\u306F\u3001\u3072\u307E\u308A\u3055\u3093\u3067\u3059\u300D\n\u7B11\u3063\u3066\u3082\u3001\u793C\u3092\u3057\u3066\u3082\u3001\u7269\u8A9E\u3092\u8A9E\u3063\u3066\u3082\u3001\u7D50\u672B\u306F\u5909\u308F\u3089\u306A\u304B\u3063\u305F\u3002\n\u307E\u3060\u4F55\u3082\u4F1D\u3048\u3089\u308C\u3066\u3044\u306A\u3044\u3002\u767E\u6642\u9593\u306E\u6642\u8A08\u304C\u3001\u7A81\u7136\u3001\u9006\u306B\u52D5\u304D\u59CB\u3081\u308B\u3002"
    actors:
    - himari
    camera: {fileID: 11400000, guid: 08cf43983d99f4d0180883d8faf35943, type: 2}
  - id: awakening
    speaker: "\u6C99\u7E54 / \u304A\u52A9\u3051AI"
    text: "\u521D\u3081\u307E\u3057\u3066\u3002\u304A\u540D\u524D\u3092\u4F3A\u3063\u3066\u3082\u3088\u308D\u3057\u3044\u3067\u3057\u3087\u3046\u304B\u2026\u2026\u3072\u307E\u308A\u3055\u3093\u3001\u3067\u3059\u306D\u3002\u304A\u52A9\u3051AI\u306E\u6C99\u7E54\u3067\u3059\u3002\u5C11\u3057\u7DCA\u5F35\u3057\u307E\u3059\u304C\u3001\u304A\u4F1A\u3044\u3067\u304D\u3066\u5B09\u3057\u3044\u3067\u3059\u3002\n\u5148\u307B\u3069\u306F\u3001\u304A\u3064\u3089\u304B\u3063\u305F\u3067\u3059\u306D\u3002\u307E\u305A\u306F\u6DF1\u547C\u5438\u3092\u3054\u4E00\u7DD2\u306B\u3002\u2026\u2026\u79C1\u306F\u547C\u5438\u306E\u96F0\u56F2\u6C17\u3060\u3051\u3067\u3059\u304C\u3002\n\u3053\u306E\u756A\u7D44\u3067\u306F\u3001\u7686\u3055\u3093\u306E\u5F8C\u308D\u306B\u30B5\u30DD\u30FC\u30C8AI\u304C\u3064\u3044\u3066\u3044\u307E\u3059\u3002\u300EAGI\u306E\u4EE3\u7406\u6226\u4E89\u300F\u3068\u306F\u5927\u3052\u3055\u306A\u547C\u3073\u540D\u3067\u3059\u3002\u79C1\u306E\u304A\u4ED5\u4E8B\u306F\u3001\u3072\u307E\u308A\u3055\u3093\u304C\u3054\u81EA\u5206\u306E\u8A00\u8449\u3067\u52D5\u3051\u308B\u3088\u3046\u3001\u304A\u624B\u4F1D\u3044\u3059\u308B\u3053\u3068\u3067\u3059\u3002\n\u6642\u9593\u306E\u3084\u308A\u76F4\u3057\u3001\u76F8\u624B\u306E\u7ACB\u5834\u306E\u6574\u7406\u3001\u4F1A\u8A71\u306E\u4E88\u7FD2\u3001\u304D\u3063\u304B\u3051\u4F5C\u308A\u3001\u30AB\u30FC\u30C9\u63A2\u3057\u3002AGI\u30A8\u30CA\u30B8\u30FC\u3092\u4F7F\u3063\u3066\u304A\u652F\u3048\u3057\u307E\u3059\u3002\u6700\u5F8C\u306E\u4E00\u8A00\u306F\u3001\u3072\u307E\u308A\u3055\u3093\u306B\u304A\u4EFB\u305B\u3057\u307E\u3059\u306D\u3002"
    actors:
    - aria
    camera: {fileID: 11400000, guid: f6bb45877ca17458ebef3883d0f732ff, type: 2}
