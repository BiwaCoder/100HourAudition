  m_Script: {fileID: 11500000, guid: def002e8071254d05a2133d9c8656ee1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HundredHour.Environments.MansionArrivalDirector
  controls: {fileID: 302497651}
  cinema: {fileID: 737287484}
  view: {fileID: 1643078438}
  introduction: {fileID: 11400000, guid: bc7c22b1690ed4715b61ff6b81b1b651, type: 2}
  firstEncounter: {fileID: 11400000, guid: 5625ea094790e49a5a577bfbc4afe3f8, type: 2}
  counterpart: {fileID: 256734021}
  openingCaptions:
  - heading: "SEASIDE MANSION / \u6D77\u8FBA\u306E\u90B8\u5B85"
    text: "\u6D77\u306B\u62B1\u304B\u308C\u305F\u3001\u767D\u4E9C\u306E\u90B8\u5B85\u3002\n\u3053\u3053\u3067\u3001\u767E\u6642\u9593\u306E\u604B\u3068\u99C6\u3051\u5F15\u304D\u304C\u5E55\u3092\u958B\u3051\u308B\u3002"
  - heading: "COURTYARD / \u51FA\u4F1A\u3044\u306E\u4E2D\u5EAD"
    text: "\u5674\u6C34\u306E\u97F3\u304C\u97FF\u304F\u4E2D\u5EAD\u3068\u3001\u5915\u967D\u3092\u6620\u3059\u5927\u304D\u306A\u7A93\u3002\n\u3053\u306E\u5834\u6240\u306B\u306F\u3001\u307E\u3060\u8AB0\u3082\u77E5\u3089\u306A\u3044\u7269\u8A9E\u304C\u5F85\u3063\u3066\u3044\u308B\u3002"
  - heading: "HIMARI / \u3042\u306A\u305F\u306E\u4E00\u6B69"
    text: "\u899A\u609F\u3068\u671F\u5F85\u3092\u80F8\u306B\u3001\u3072\u307E\u308A\u306F\u821E\u53F0\u3078\u3002\n\u3042\u306A\u305F\u306E\u4E00\u6B69\u304B\u3089\u3001\u3053\u306E\u30AA\u30FC\u30C7\u30A3\u30B7\u30E7\u30F3\u306F\u52D5\u304D\u51FA\u3059\u3002"
  - heading: "FIRST STEP / \u3042\u306E\u4EBA\u306E\u3082\u3068\u3078"
    text: "\u6E96\u5099\u306F\u3044\u3044\uFF1F\u3000\u30EC\u30C3\u30C9\u30AB\u30FC\u30DA\u30C3\u30C8\u306E\u5148\u3078\u9032\u3082\u3046\u3002"
  encounterCaption:
    heading: "FIRST CONTACT / \u8A8D\u8B58\u3067\u304D\u306A\u3044\u76F8\u624B"
    text: "\u3044\u307E\u3001\u65B0\u305F\u306A\u7269\u8A9E\u304C\u59CB\u307E\u308B\u3002\n\u7DCA\u5F35\u3067\u3001\u76F8\u624B\u306E\u8868\u60C5\u304C\u3046\u307E\u304F\u8AAD\u307F\u53D6\u308C\u306A\u3044\u3002"
  encounterDistance: 3
  textFadeSeconds: 0.7
